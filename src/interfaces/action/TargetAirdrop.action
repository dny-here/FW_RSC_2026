# ACTION: TargetAirdrop
# Server : node airdrop_planning  (nama action: "execute_airdrop")
# Client : node target_recognition

# ------------------------------ Goal ------------------------------
# Koordinat target final (WGS-84) hasil georeferencing, dikirim hanya
# setelah node visi mengumpulkan cukup deteksi (mis. 75 frame).
interfaces/TargetEstimate gps_estimation

# Bay mekanisme dropping yang akan dilepas untuk goal ini (0 atau 1).
uint8 bay_index

---
# ----------------------------- Result -----------------------------
# Dikirim sekali: setelah payload dilepas (succeed), atau saat goal
# di-abort (missed target berulang / drop service gagal) atau cancel.
bool drop_successful
string message                 # keterangan human-readable utk log/GCS
float64 release_miss_m         # jarak wahana ke release point saat rilis [m]
uint8 replans                  # berapa kali replan akibat missed target

---
# ---------------------------- Feedback ----------------------------
# Telemetri kontinu (rate = loop FSM, ~20 Hz) selama wahana menjalani
# truncated Dubins path: fase aktif (Transit/Loiter/Final Approach)
# dan jarak tersisa ke release point.
interfaces/AirdropStatus current_status