    <link name="elevator_link">
      <pose relative_to="elevator_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000102319</ixx>
          <ixy>0</ixy>
          <iyy>0.00334417</iyy>
          <ixz>0</ixz>
