    <link name="left_aileron_link">
      <pose relative_to="left_aileron_joint">0 0 0 -0.087266463 0 -0.034906585</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000102319</ixx>
